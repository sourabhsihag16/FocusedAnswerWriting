# Optional: used when running docker-compose (docker-compose loads .env from this directory).
# Copy to .env and set values as needed.

# JWT (backend)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Optional: ChatGPT question generation (backend cron)
GENERATE_CHATGPT_QUESTIONS=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
