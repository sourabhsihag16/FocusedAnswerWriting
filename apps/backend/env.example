# Server Configuration
# Default port is 8080 (direct run) or 8081 when using Docker (mapped from container port 8080)
PORT=8080
GIN_MODE=debug  # Use 'release' for production

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=focused_answer_writing
DB_SSLMODE=disable

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# App Configuration
APP_ENV=development
