# Server Configuration
PORT=8081
GIN_MODE=debug

# Database Configuration (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=focused_answer_writing
DB_SSLMODE=disable

# JWT Configuration (used only when auth is enabled)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# App Configuration
APP_ENV=development

# Optional: Daily questions from Google Spreadsheet (CSV export URL)
# When set, GET /api/v1/questions/today and GET /api/v1/questions/:id use the spreadsheet instead of DB.
# Sheet columns: Date (YYYY-MM-DD), Question 1, Question 2. Publish sheet to web as CSV and paste the URL here.
# QUESTIONS_CSV_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/export?format=csv&gid=0

# Optional: ChatGPT question generation (cron fills next 7 days with 2 questions each if missing)
# Set to true to generate questions via OpenAI when a day has no questions (only used when QUESTIONS_CSV_URL is not set)
GENERATE_CHATGPT_QUESTIONS=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
