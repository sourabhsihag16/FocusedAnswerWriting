# API Configuration for Expo Mobile App
# 
# Copy this file to .env and update with your settings
#
# For Android Emulator: Leave as localhost (or use 10.0.2.2)
# For iOS Simulator: Leave as localhost
# For Physical Devices (Android/iOS): Use your computer's local IP address
#
# To find your Mac's local IP address, run:
#   pnpm get-ip
#   or: ipconfig getifaddr en0
#
# Example for physical device:
# EXPO_PUBLIC_API_URL=http://192.168.1.100:8080/api/v1

EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1
